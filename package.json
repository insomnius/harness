{
  "name": "@insomnius/harness",
  "version": "0.1.0",
  "private": true,
  "description": "Install Harness skills for Codex, Claude Code, and Pi",
  "type": "module",
  "bin": {
    "harness-skills": "bin/harness.mjs",
    "harness": "bin/harness.mjs",
    "frontend-security": "bin/frontend-security.mjs"
  },
  "files": [
    "bin/",
    "tools/frontend-security/**",
    "!tools/**/__pycache__/**",
    "!tools/**/*.py[cod]",
    "!tools/**/.DS_Store",
    ".claude-plugin/marketplace.json",
    "plugins/*/skills/**",
    "!plugins/**/__pycache__/**",
    "!plugins/**/*.py[cod]",
    "!plugins/**/.DS_Store",
    "plugins/design-thinking/UPSTREAM.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/install.test.mjs tests/security.test.mjs",
    "test:security": "bun test tools/frontend-security/tests",
    "security:check": "node bin/frontend-security.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insomnius/harness.git"
  }
}
